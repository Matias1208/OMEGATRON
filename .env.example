# Base de datos (docker-compose)
DATABASE_URL="postgresql://omegatron:omegatron@localhost:5432/omegatron?schema=public"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Firebase Admin SDK (Consola Firebase > Configuración > Cuentas de servicio > Generar nueva clave privada)
# Puedes llenarlas automáticamente con: npm run firebase:env -- ruta/al/service-account.json
FIREBASE_PROJECT_ID="omegatron-hackathon"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@omegatron-hackathon.iam.gserviceaccount.com"
# En UNA sola línea, entre comillas dobles, con los saltos de línea como \n literales
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Consola Firebase > Realtime Database > URL que aparece arriba de los datos
FIREBASE_DATABASE_URL="https://omegatron-hackathon-default-rtdb.firebaseio.com"

# Clave compartida con la ESP32 y el script de visión (header x-api-key)
HARDWARE_API_KEY="cambia-esto"
