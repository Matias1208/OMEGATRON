# Base de datos (docker-compose)
DATABASE_URL="postgresql://omegatron:omegatron@localhost:5432/omegatron?schema=public"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Clave compartida con la ESP32 y el script de visión (header x-api-key)
HARDWARE_API_KEY="cambia-esto"
# true = sin límite de EPP por persona (no bloquea por vida útil). SOLO para pruebas: false en la demo.
MODO_PRUEBAS="false"

# Alertas programadas (vida útil cumplida, lotes por vencer, stock bajo)
# Local: el servidor las ejecuta solo cada N minutos (vacío = desactivado)
CRON_INTERNO_MINUTOS="60"
# Producción: GET /api/cron/alertas con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""
